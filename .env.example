# Public URL used by the API in email links and by the web build for SEO files.
PUBLIC_SITE_URL=https://kaipov24.github.io/hiring-people
PUBLIC_APP_URL=http://localhost:8080

# Static landing page / home lab split.
# Use VITE_DEPLOY_TARGET=landing for GitHub Pages and app for the home server.
VITE_DEPLOY_TARGET=app
VITE_APP_BASE_URL=http://localhost:8080
VITE_BASE_PATH=/
CLOUDFLARE_TUNNEL_TOKEN=

# Login session lifetime. Examples: 1h, 8h, 7d.
JWT_EXPIRES_IN=8h

# Local default uses Mailpit from compose.yaml.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_USER=
SMTP_PASS=
MAIL_FROM="inclusive-hire <no-reply@inclusive-hire.local>"

# Comma-separated emails that should see the admin section after login.
ADMIN_EMAILS=

# Resume storage. Use local for development, r2 for Cloudflare R2.
STORAGE_DRIVER=r2
R2_ENDPOINT=https://d3eaceebaa6fb512aead5d94cc0bfa7e.r2.cloudflarestorage.com

R2_BUCKET=inclusive-hire-resumes
R2_REGION=auto
R2_ACCESS_KEY_ID=a23f83b5feec5489f0791fcc64afef5f
R2_SECRET_ACCESS_KEY=68e6c9b90b9cea7561316f4eacb96c1a0134e06c48dcfe82af37c46c75d47707

# Example for Brevo:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=your-brevo-smtp-login
# SMTP_PASS=your-brevo-smtp-key
# MAIL_FROM="inclusive-hire <verified-sender@your-domain.example>"

# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_REQUIRE_TLS=false
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-google-app-password
# MAIL_FROM="inclusive-hire <your-address@gmail.com>"
