# App URL used inside verification and password reset emails.
PUBLIC_APP_URL=http://localhost:8080

# Local default uses Mailpit from compose.yaml.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=inclusive-hire <no-reply@inclusive-hire.local>

# Example for Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-google-app-password
# MAIL_FROM=inclusive-hire <your-address@gmail.com>
