# Copy this file to .env on the Linux laptop/home server.
# Do not commit the copied .env file.

# Public GitHub Pages landing URL.
PUBLIC_SITE_URL=https://kaipov24.github.io/hiring-people

# Public Cloudflare Tunnel app URL for the home server.
PUBLIC_APP_URL=https://inclusive-hire.org.kg

# Home app build mode.
VITE_DEPLOY_TARGET=app
VITE_APP_BASE_URL=https://inclusive-hire.org.kg
VITE_BASE_PATH=/

# Token from Cloudflare Zero Trust tunnel setup.
CLOUDFLARE_TUNNEL_TOKEN=

# Login session lifetime.
JWT_EXPIRES_IN=8h

# Admin emails, comma-separated.
ADMIN_EMAILS=you@example.com

# Brevo SMTP example. Replace with real values after sender verification.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
MAIL_FROM="inclusive-hire <no-reply@inclusive-hire.org.kg>"

# Resume storage. Use local first, then switch to r2 after Cloudflare R2 is ready.
STORAGE_DRIVER=local
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional MongoDB backup upload to Cloudflare R2.
BACKUP_STORAGE_DRIVER=local
BACKUP_R2_PREFIX=backups/mongodb
AWS_CLI_IMAGE=public.ecr.aws/aws-cli/aws-cli:latest
